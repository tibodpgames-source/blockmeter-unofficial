{
  "schemaVersion": 1,
  "id": "blockmeter",
  "version": "${version}",
  "environment": "*",
  "entrypoints": {
    "client": ["win.baruna.blockmeter.BlockMeterClient"],
    "main": ["win.baruna.blockmeter.BlockMeterServer"],
    "modmenu": ["win.baruna.blockmeter.gui.ModMenu"]
  },
  "custom": {
    "xxxmodmenu:clientsideOnly": true,
    "unofficial-port": true
  },
  "mixins": ["blockmeter.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": ">=0.161.0",
    "minecraft": "26.3",
    "java": ">=25"
  },
  "recommends": {
    "modmenu": "*"
  },
  "name": "Block Meter Unofficial",
  "description": "Unofficial Minecraft 26.3 port of Block Meter. Measure block distances and boxes.",
  "icon": "icon.png",
  "authors": ["MadeOke", "Giselbaer", "ModProg"],

  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/blockmeterfabric",
    "sources": "https://github.com/modprog/BlockMeter"
  },

  "license": "MIT"
}
